# Required
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/semivra?retryWrites=true&w=majority
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Production
NODE_ENV=production
ALLOWED_ORIGINS=https://pos.your-domain.com,https://admin.your-domain.com

# Optional
PORT=5002
LOG_LEVEL=info
ADMIN_PASS=ChangeMe@2026!
# Business type — MUST match the client's VITE_BUSINESS_TYPE exactly, and the
# client MUST be rebuilt after changing it (Vite bakes env vars at build time).
#   fb  = food & beverage (QR ordering, Dine-In/Kitchen/Bar departments)
#   log = logistics (client-login ordering, Storage Room, billing statements,
#         Client Accounts panel in the Command Center)
# A mismatch is caught at runtime by a banner on the client (via /health).
BUSINESS_TYPE=fb
# Error monitoring — leave blank to disable. When set, 5xx errors + crashes report to Sentry.
SENTRY_DSN=
