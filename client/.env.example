# ── Client (Vite) environment ──────────────────────────────────────────────
# All client vars MUST be prefixed VITE_ to be exposed to the browser build.

# ===== Required =====
# Backend API base URL (no trailing slash).
VITE_API_URL=https://api.your-domain.com

# Business type — MUST match the server's BUSINESS_TYPE exactly.
#   fb  = food & beverage (QR ordering, Dine-In/Kitchen/Bar)
#   log = logistics (client-login ordering, Storage Room, billing statements,
#         package-based inventory & COGS)
VITE_BUSINESS_TYPE=fb

# Shown in sidebar, login, receipts, customer menu.
VITE_BUSINESS_NAME=Your Business Name

# ===== Optional =====
# Public site URL used for QR codes / links (defaults to current origin).
VITE_FRONTEND_URL=https://pos.your-domain.com
# UI theme key (optional).
VITE_THEME=
# Facebook page link (logistics) — clients send payment proof here after ordering.
VITE_FB_LINK=https://facebook.com/your-page

# ===== Billing statement (logistics / log mode only) =====
# Printed on the billing statement. Leave blank to fall back to VITE_BUSINESS_NAME.
VITE_BILLING_NAME=
VITE_BILLING_ADDRESS1=
VITE_BILLING_ADDRESS2=
VITE_BILLING_PHONE=
VITE_BILLING_EMAIL=
VITE_BILLING_BANK=
VITE_BILLING_ACCOUNT_NAME=
VITE_BILLING_ACCOUNT_NO=
