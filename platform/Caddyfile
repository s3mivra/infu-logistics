{
	email {$ACME_EMAIL}
	# LOCAL_MODE=1 turns off certificate issuance so the whole thing can be
	# rehearsed on a laptop with no public DNS. Unset it on the VPS.
	{$CADDY_GLOBAL_EXTRA}
}

# Per-tenant vhosts are generated by the control plane into tenants/*.caddy and
# picked up by this import. Caddy is reloaded (not restarted) after each change,
# so adding a client never interrupts the ones already running.
import /etc/caddy/tenants/*.caddy
