# Platform-level config. Copy to platform/.env and fill in.
# Per-tenant secrets are generated by the control plane into tenants/<slug>/.env.

# Wildcard vhosts are issued under this domain: <slug>.semivra.asia
DOMAIN=semivra.asia

# Let's Encrypt registration + renewal notices.
ACME_EMAIL=semivra@gmail.com

# Absolute path to this repo ON THE HOST. Must be identical inside and outside
# the control-plane container, so `docker compose` resolves build contexts the
# same way the daemon does. On the VPS: /opt/semivra
STACK_ROOT=/opt/semivra

# Sign-in password for the control-plane UI.
CP_PASSWORD=change-me-long-and-random

# Second password, required on top of the first for wipe and delete.
# MUST be different from CP_PASSWORD — the server refuses to start otherwise.
CP_DANGER_PASSWORD=change-me-too-and-different

# Hostname the control plane is served on. Must not collide with <slug>.<DOMAIN>.
CP_HOST=app.semivra.asia
# Extra login gate Caddy puts in front of the control plane at CP_HOST.
# Hash: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'yourpass'
# Escape every $ in the hash as $$ here, or compose will mangle it.
CP_BASIC_USER=admin
CP_BASIC_HASH=

# Local rehearsal only: serves tenants over plain http and skips certificate
# issuance, so the flow can be tested with no public DNS. Leave UNSET on the VPS.
# LOCAL_MODE=1
# CADDY_GLOBAL_EXTRA=auto_https off

# ── MongoDB authentication (see MONGO_AUTH.md before changing on a live box) ──
MONGO_AUTH=off
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=
MONGO_KEYFILE_CONTENT=
# New deployments only (empty data dir): same values as MONGO_ROOT_*.
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
# With auth on: mongodb://root:<password>@mongo:27017/?replicaSet=rs0&authSource=admin
MONGO_BACKUP_URI=

# ── Backups ──
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=14
# Offsite (docker compose --profile offsite up -d). R2: provider Cloudflare,
# endpoint https://<account>.r2.cloudflarestorage.com. B2: provider Other,
# endpoint https://s3.<region>.backblazeb2.com
OFFSITE_PROVIDER=Cloudflare
OFFSITE_ENDPOINT=
OFFSITE_BUCKET=
OFFSITE_ACCESS_KEY_ID=
OFFSITE_SECRET_ACCESS_KEY=
